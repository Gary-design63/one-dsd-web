{
  "name": "one-dhs-pac",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.x",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node scripts/testing/run-tests.mjs",
    "test:corpus:local": "node scripts/testing/run-local-corpus.mjs",
    "corpus:fixtures:bootstrap": "node scripts/corpus/bootstrap-local-fixtures.mjs",
    "verify:environment": "node scripts/verify-environment.mjs",
    "verify:environment:production": "node scripts/verify-environment.mjs --mode production",
    "verify:sources": "node scripts/corpus/verify-source-ledger.mjs",
    "corpus:check": "node scripts/corpus/build-shadow-import.mjs --check",
    "corpus:stage": "node scripts/corpus/build-shadow-import.mjs --write",
    "corpus:load": "node --env-file-if-exists=.env.local scripts/corpus/load-shadow-import-v2.mjs",
    "corpus:benchmark": "node scripts/corpus/benchmark-batched-import.mjs",
    "corpus:canonical:check": "node scripts/corpus/build-canonical-projection.mjs --check",
    "corpus:canonical:stage": "node scripts/corpus/build-canonical-projection.mjs --write",
    "corpus:canonical:load": "node --env-file-if-exists=.env.local scripts/corpus/load-canonical-projection.mjs",
    "corpus:objects:check": "node scripts/corpus/build-source-objects.mjs --check",
    "corpus:objects:stage": "node scripts/corpus/build-source-objects.mjs --write",
    "corpus:objects:load": "node --env-file-if-exists=.env.local scripts/corpus/load-source-objects.mjs",
    "seed:release:capture": "node scripts/corpus/capture-seed-release.mjs --check",
    "seed:release:check": "node scripts/corpus/build-seed-release.mjs --check",
    "seed:release:stage": "node scripts/corpus/build-seed-release.mjs --write",
    "seed:release:load": "node --env-file-if-exists=.env.local scripts/corpus/load-seed-release.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:provision-runtime": "node --env-file-if-exists=.env.local scripts/db/provision-runtime-role.mjs",
    "verify": "npm run verify:ci",
    "verify:ci": "npm run verify:environment && npm run verify:sources && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@huggingface/transformers": "4.2.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "next": "16.3.4",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "onnxruntime-node": "1.29.0",
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  }
}
