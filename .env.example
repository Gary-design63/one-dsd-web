# One DHS PAC environment (copy to .env.local). Never commit real values.

# Owner key for the Practice Workspace (required in preview/production; dev falls back to a labeled local default)
PAC_OWNER_KEY=

# Shared One DSD Team key. The consultant gives it to approved team members; change it to remove access.
# Required in preview/production; dev falls back to a labeled local default.
PAC_TEAM_KEY=

# HMAC key for privacy-minimized, distributed request limits. Required in every deployed environment.
PAC_RATE_LIMIT_SECRET=

# Store backend: memory (temporary) | file (.data/ on disk; default in development) | postgres (shared and durable)
PAC_STORE=
# Durable-resource boundary. Vercel Preview must use preview; Vercel Production must use production.
PAC_DATA_ENV=local

# Database owner connection for migrations, imports, and restricted-role provisioning only.
# Never give this connection to the running application.
PAC_DATABASE_URL=
# Restricted server connection. Required when PAC_STORE=postgres or PAC_CONTENT_SOURCE=postgres.
PAC_RUNTIME_DATABASE_URL=
PAC_RUNTIME_DATABASE_SSL=
# Keep both connections in ignored .env.local. Never create NEXT_PUBLIC_ versions.
PAC_DATABASE_SSL=
PAC_IMPORT_ACTOR=
PAC_IMPORT_BATCH_SIZE=500
PAC_IMPORT_BATCH_BYTES=1048576

# Staff publication source and scope. Keep static until reviewed database publications are ready.
PAC_CONTENT_SOURCE=static
# Optional comma-separated surface IDs for local staged editing. Leave empty for full PostgreSQL publication.
PAC_DATABASE_EDITABLE_SURFACES=
PAC_STAFF_SCOPE=one-dhs

# Private source-object storage. Keep the secret key server-side and use a private bucket only.
# Never create a NEXT_PUBLIC_ version of the secret key.
PAC_SUPABASE_URL=
PAC_SUPABASE_BUCKET=one-dsd-private
PAC_SUPABASE_SECRET_KEY=

# Consultation requests remain a preview until durable shared storage and owner delivery are ready.
# Turn on only after both have been verified.
PAC_CONSULTATION_INTAKE_ENABLED=off
# Existing-request tracking can remain available while new intake is off. Selecting consultation
# activation evidence requires this tracking secret, and production rejects any configured weak,
# placeholder, or low-variation value even when PAC_CONSULTATION_INTAKE_ENABLED stays off.
PAC_CONSULTATION_TRACKING_SECRET=
PAC_CONSULTATION_POLICY_VERSION=
PAC_CONSULTATION_ACTIVATION_EVIDENCE_ID=
PAC_CONSULTATION_RETENTION_DAYS=
PAC_CONSULTATION_CORRECTION_READY=off
PAC_CONSULTATION_DELETION_READY=off
PAC_CONSULTATION_BACKUP_READY=off
PAC_CONSULTATION_RESTORE_READY=off
PAC_CONSULTATION_RECOVERY_READY=off
PAC_CONSULTATION_INCIDENT_READY=off
PAC_CONSULTATION_DELIVERY_READY=off

# Generative pilot: off by default. Turn on only with a server-side key and an owner decision.
PAC_GENERATIVE_PILOT=off
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Autonomy policy defaults (the owner can change these at runtime from the Practice Workspace)
PAC_AUTONOMY_MAX=A0
PAC_KILL_SWITCH=off

# Scheduled orchestrator cycle (Vercel cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Current public-source research. The consultant controls availability for all staff.
PAC_RESEARCH_ENABLED=off
PAC_RESEARCH_KILL_SWITCH=off
# 0 means no cap. Usage is still recorded for the consultant.
PAC_RESEARCH_MONTHLY_USD_CAP=0
PERPLEXITY_API_KEY=
# Dynamic Agent API presets. Perplexity currently maps low to everyday current research and
# medium to deeper multi-source research.
PAC_PERPLEXITY_CURRENT_PRESET=low
PAC_PERPLEXITY_DEEP_PRESET=medium

# Stage Zero Microsoft decision. These values record a selected but disconnected route;
# they do not activate a transport.
PAC_MICROSOFT_ADAPTER=attended_personal_teams_bridge
PAC_MICROSOFT_KILL_SWITCH=on

# Owner-machine source verification only. These paths and test switches never belong in Vercel.
PAC_CATALOG_PATH=
PAC_IMPORT_BENCHMARK_DATABASE_URL=
PAC_RESEARCH_FIXTURE=off
PAC_REQUIRE_LOCAL_CORPUS=0

# ASK records: blank keeps records until owner deletion. Optional positive days apply to new records.
PAC_ASK_RECORD_RETENTION_DAYS=
